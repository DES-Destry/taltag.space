# ===========================================
# TalentTag — Copy to .env and run: npm run setup
# ===========================================

# 1. Helius RPC (free at https://helius.dev)
#    Devnet recommended for testing (free SOL: https://faucet.solana.com):
HELIUS_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY
SOLANA_NETWORK=devnet

#    Mainnet:
# HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY

# 2. Run: npm run setup (generates keypair, creates tree, fills below)
MINT_KEYPAIR=
BADGE_CREATOR_ADDRESS=
MERKLE_TREE_ADDRESS=

# 3. App URL for metadata & images (required for production)
# NEXT_PUBLIC_APP_URL=https://taltag.space
