{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    },
    {
      "source": "/about",
      "destination": "/learn",
      "statusCode": 308,
      "regex": "^(?!/_next)/about(?:/)?$"
    },
    {
      "source": "/how-it-works",
      "destination": "/learn",
      "statusCode": 308,
      "regex": "^(?!/_next)/how-it-works(?:/)?$"
    },
    {
      "source": "/faq",
      "destination": "/learn",
      "statusCode": 308,
      "regex": "^(?!/_next)/faq(?:/)?$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/badge-meta/[id]",
      "regex": "^/api/badge\\-meta/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/badge\\-meta/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/badges/[assetId]",
      "regex": "^/api/badges/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPassetId": "nxtPassetId"
      },
      "namedRegex": "^/api/badges/(?<nxtPassetId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/badge/[assetId]",
      "regex": "^/badge/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPassetId": "nxtPassetId"
      },
      "namedRegex": "^/badge/(?<nxtPassetId>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/api/badge-image",
      "regex": "^/api/badge\\-image(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/badge\\-image(?:/)?$"
    },
    {
      "page": "/api/badge-image/png",
      "regex": "^/api/badge\\-image/png(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/badge\\-image/png(?:/)?$"
    },
    {
      "page": "/api/badges",
      "regex": "^/api/badges(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/badges(?:/)?$"
    },
    {
      "page": "/api/claim",
      "regex": "^/api/claim(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/claim(?:/)?$"
    },
    {
      "page": "/claim",
      "regex": "^/claim(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/claim(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    },
    {
      "page": "/gallery",
      "regex": "^/gallery(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/gallery(?:/)?$"
    },
    {
      "page": "/learn",
      "regex": "^/learn(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/learn(?:/)?$"
    },
    {
      "page": "/sitemap.xml",
      "regex": "^/sitemap\\.xml(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/sitemap\\.xml(?:/)?$"
    },
    {
      "page": "/skills",
      "regex": "^/skills(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/skills(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": false,
    "dynamicRSCPrerender": false
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}